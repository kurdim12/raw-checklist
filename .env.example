# Public (safe to expose to client)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Private (only used by scripts/ and supabase/functions/, NEVER in client)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Low-stock alert webhook (CallMeBot / n8n / Twilio / anything that accepts POST JSON)
# Used by supabase/functions/low-stock-alert
WHATSAPP_WEBHOOK_URL=https://api.callmebot.com/whatsapp.php?phone=...&text=...&apikey=...

# Cafe metadata
CAFE_TIMEZONE=Asia/Amman
CAFE_CURRENCY=JOD
